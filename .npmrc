# Supply-chain cooldown: only resolve package versions published at least
# 7 days ago (needs npm 11.10+; older npm ignores it with a warning).
# Applies to install/update/outdated; installs from package-lock.json are
# unaffected.
min-release-age=7

# React and Vercel packages go straight to latest. Each React/Next release
# exact-pins its companions, so those are exempt too.
min-release-age-exclude[]=react
min-release-age-exclude[]=react-dom
min-release-age-exclude[]=react-server-dom-webpack
min-release-age-exclude[]=scheduler
min-release-age-exclude[]=eslint-plugin-react-hooks
min-release-age-exclude[]=@types/react
min-release-age-exclude[]=@types/react-dom
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=@swc/helpers
min-release-age-exclude[]=styled-jsx
min-release-age-exclude[]=@vercel/*
min-release-age-exclude[]=ai
min-release-age-exclude[]=@ai-sdk/*
